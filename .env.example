# ─── Local development ───────────────────────────────────────────────
# Leave DATABASE_URL unset to use the embedded PGlite database and local
# file uploads. `npm run db:seed` then `npm run dev`.

# ─── Production (Vercel) ─────────────────────────────────────────────
# Postgres (Neon). When set, the app uses Neon instead of PGlite and the
# build runs migrations automatically (scripts/migrate.mjs).
# DATABASE_URL=postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/db?sslmode=require

# Vercel Blob — durable storage for uploaded images and payment receipts.
# Create a Blob store in the Vercel dashboard; it injects this token.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Upstash Redis — distributed rate limiting (intake, logins, uploads).
# Optional: without it, an in-memory limiter is used (per-instance only).
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# Site deploy hook — the "Publish to website" button POSTs here to rebuild the
# public site (which re-fetches /api/site-content). Create it in Vercel:
# turnkii-site → Settings → Git → Deploy Hooks. Without it, publishing still
# saves content but won't auto-rebuild.
# SITE_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/xxx

# ─── First admin (run once, see: npm run db:bootstrap) ───────────────
# ADMIN_EMAIL=you@company.com
# ADMIN_PASSWORD=a-strong-password-min-10-chars
# ADMIN_NAME=Your Name
